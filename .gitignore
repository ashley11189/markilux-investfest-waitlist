# ── dependencies ──────────────────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── next.js ───────────────────────────────────────────────────────────────
/.next/
/out/
/build
*.tsbuildinfo
next-env.d.ts

# ── environment ───────────────────────────────────────────────────────────
# Never commit real credentials. .env.example is the documented template and
# is intentionally tracked.
.env
.env.*
!.env.example

# ── deployment ────────────────────────────────────────────────────────────
.vercel

# ── testing ───────────────────────────────────────────────────────────────
/coverage
/playwright-report
/test-results

# ── supabase local ────────────────────────────────────────────────────────
/supabase/.branches
/supabase/.temp
/supabase/.env

# ── logs ──────────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── editors / os ──────────────────────────────────────────────────────────
.DS_Store
*.pem
.idea/
.vscode/*
!.vscode/extensions.json
