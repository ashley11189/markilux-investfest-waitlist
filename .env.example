# ═══════════════════════════════════════════════════════════════════════════
# markilux Private Sale Initiative — environment
#
# Copy to .env.local for development. In production these are set in the
# Vercel dashboard (Project → Settings → Environment Variables).
#
# Only NEXT_PUBLIC_* variables reach the browser. Everything else is
# server-only and must never be prefixed with NEXT_PUBLIC_.
# ═══════════════════════════════════════════════════════════════════════════

# ── Supabase ───────────────────────────────────────────────────────────────
# Supabase dashboard → Project Settings → API

# Your project's REST URL. Safe to expose.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# SECRET. Bypasses Row Level Security — it is the only way into the signups
# table, and it must never appear in client code or in the repository.
# Rotate it immediately if it is ever pasted anywhere public.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Signup security ────────────────────────────────────────────────────────

# SECRET. Salts the SHA-256 hash of visitor IP addresses used for rate
# limiting, so the stored value can't be reversed into an address.
# Generate with: openssl rand -base64 32
# Changing it resets rate-limit history.
SIGNUP_IP_SALT=replace-with-a-long-random-string

# ── Organizer panel ────────────────────────────────────────────────────────

# SECRET. What booth staff type to view and export the lead list.
# This replaces the old client-side "MKX-2026" code, which anyone could read
# in the page source. Rotate it after the event.
ORGANIZER_PASSCODE=choose-a-strong-passcode

# SECRET. Signs the organizer session cookie. Minimum 32 characters.
# Generate with: openssl rand -base64 32
ORGANIZER_SESSION_SECRET=replace-with-at-least-32-random-characters

# ── Signup notifications (optional) ────────────────────────────────────────
# Emails you every time somebody joins the list.
#
# Leave everything below unset and notifications are simply off — signups are
# still saved and still visible in the back office. Nothing here can fail a
# submission: the mail is sent after the response, and errors are logged
# rather than raised.
#
# Two transports are supported. Gmail is used whenever its four variables are
# all present; otherwise SMTP is tried. markilux.us runs on Google Workspace,
# so Gmail is the intended path.

# Where notifications land. Comma-separate for more than one recipient.
# Required by BOTH transports — without it, notifications stay off.
SIGNUP_NOTIFY_TO=privatesale@markilux.us

# ── Gmail API (preferred) ──────────────────────────────────────────────────
# Google Cloud console → enable "Gmail API" → Credentials → OAuth client ID →
# Application type "Desktop app". Then mint the refresh token once with:
#
#   npm run gmail:auth
#
# It prints GMAIL_REFRESH_TOKEN and GMAIL_SENDER. The scope requested is
# gmail.send only — the app cannot read the mailbox.
GMAIL_CLIENT_ID=
# SECRET.
GMAIL_CLIENT_SECRET=
# SECRET. Long-lived; can send as that mailbox until revoked at
# myaccount.google.com/permissions.
GMAIL_REFRESH_TOKEN=
# The mailbox that sends. Must be the account you authorised above.
GMAIL_SENDER=
# Display name on the From line.
GMAIL_SENDER_NAME=markilux private sale

# ── SMTP (fallback) ────────────────────────────────────────────────────────
# Only consulted when the Gmail variables are not all set.

# e.g. smtp.gmail.com or smtp.office365.com.
SMTP_HOST=
# 587 uses STARTTLS (most common); 465 is implicit TLS.
SMTP_PORT=587
# SECRET. Usually the full mailbox address.
SMTP_USER=
# SECRET. For Google Workspace or Microsoft 365 with 2FA this must be an
# app password, not the account password.
SMTP_PASSWORD=
# Defaults to SMTP_USER. Many providers reject a From that isn't the mailbox.
SMTP_FROM=

# ── Event ──────────────────────────────────────────────────────────────────

# Must match an events.slug row in the database. Seeded by the initial
# migration as 'investfest-2026'.
NEXT_PUBLIC_EVENT_SLUG=investfest-2026

# Canonical site URL, used for Open Graph image resolution.
NEXT_PUBLIC_SITE_URL=https://your-deployment.vercel.app
